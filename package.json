{
  "name": "studio-booking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build-tenants.ts assets && vite",
    "build": "tsx scripts/build-tenants.ts assets && tsc -p tsconfig.app.json --noEmit && vite build && tsx scripts/build-tenants.ts html",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tenant:new": "tsx scripts/tenant.ts new",
    "tenant:check": "tsx scripts/tenant.ts check",
    "tenant:publish": "tsx scripts/tenant.ts publish",
    "tenant:verify": "tsx scripts/tenant.ts verify",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy public-api --no-verify-jwt && supabase functions deploy reminders --no-verify-jwt",
    "reviews:sync": "tsx scripts/import-yandex-reviews.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.15",
    "@astryxdesign/theme-neutral": "^0.7.15",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.2",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "liquid-gl": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.15",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@10.34.9"
}
